# docker compose dev 环境变量（仅供 make dev 使用：compose 变量 + 构建参数）
# 后端业务配置写在仓库根 .env.dev；这里只放编排相关项。

# 宿主机端口（与仓库根 .env.dev 的 IMAGE_STUDIO_PORT 保持一致，前端 vite 代理也读它）
IMAGE_STUDIO_PORT=25050

# 宿主机路径（相对本文件所在目录 docker/）
DEV_DATA_DIR=../.data
MODEL_HUB_PATH=/data/vos_workspace/public/model_hub

MODEL_HUB_API_URL=http://172.17.0.1:35005

# GPU
NVIDIA_VISIBLE_DEVICES=all

# 构建参数
GITHUB_ACCELERATOR=https://gh-proxy.com/
UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple/
